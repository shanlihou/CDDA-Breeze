      },
      {
        "text": "[婚约]我们结婚吧（使用结婚戒指求婚，信任30+，价值30+）",
        "condition": {
          "and": [
            { "not": { "npc_has_trait": "ENGAGEMENT" } },
            { "not": { "u_has_trait": "ENGAGEMENT" } },
            { "compare_int": [ { "npc_val": "npc_trust" }, ">=", { "const": 30 } ] },
            { "compare_int": [ { "npc_val": "npc_value" }, ">=", { "const": 30 } ] },
            { "u_has_items": { "item": "ring_engagement", "count": 1 } }
