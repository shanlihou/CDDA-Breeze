        "condition": { "and": [ { "npc_has_trait": "ENGAGEMENT" }, { "u_has_trait": "ENGAGEMENT" } ] }
      },
      {
        "text": "[解约]我们解除婚约吧",
        "topic": "解除婚约",
        "condition": { "and": [ { "npc_has_trait": "ENGAGEMENT" }, { "u_has_trait": "ENGAGEMENT" } ] }
