                  "select_npc_anthro_feline_morehuman_female",
                  "select_npc_anthro_feline_half_female",
                  "select_npc_anthro_feline_lesshuman_female",
                  
                  "select_npc_anthro_ursine_morehuman_male",
                  "select_npc_anthro_ursine_half_male",
                  "select_npc_anthro_ursine_lesshuman_male",
                  "select_npc_anthro_ursine_morehuman_female",
                  "select_npc_anthro_ursine_half_female",
                  "select_npc_anthro_ursine_lesshuman_female",
                  
                  "select_npc_anthro_cattle_morehuman_male",
                  "select_npc_anthro_cattle_half_male",
                  "select_npc_anthro_cattle_lesshuman_male",
                  "select_npc_anthro_cattle_morehuman_female",
                  "select_npc_anthro_cattle_half_female",
                  "select_npc_anthro_cattle_lesshuman_female",
                  
                  "select_npc_anthro_rabbit_morehuman_male",
                  "select_npc_anthro_rabbit_half_male",
                  "select_npc_anthro_rabbit_lesshuman_male",
                  "select_npc_anthro_rabbit_morehuman_female",
                  "select_npc_anthro_rabbit_half_female",
                  "select_npc_anthro_rabbit_lesshuman_female",
                  
                  "select_npc_anthro_bird_morehuman_male",
                  "select_npc_anthro_bird_half_male",
                  "select_npc_anthro_bird_lesshuman_male",
                  "select_npc_anthro_bird_morehuman_female",
                  "select_npc_anthro_bird_half_female",
                  "select_npc_anthro_bird_lesshuman_female",
                  
                  "EOC_NONE"
                ],
                "names": [
                  "类人生物",
                  "形似恶魔",
                  
                  "类人生物",
                  "形似恶魔",
                  
                  "类人生物(男)",
                  "半人生物(男)",
                  "非人生物(男)",
                  "类人生物(女)",
