[
  {
    "type": "effect_on_condition",
    "id": "anthropomorph_actor_use",
    "condition": { "u_has_item": "syringe" },
    "effect": [
      {
        "u_query_tile": "around",
        "target_var": { "context_val": "pnt" },
        "range": 1,
        "message": "选择使用对象的方向"
      },
      { "set_string_var": "", "target_var": { "global_val": "anthro_npc" } },
      {
        "run_eocs": "eoc_check_u_query_tile_target",
        "variables": { "retv": "tmp", "pnt": { "context_val": "pnt" } }
      },
      
      {
        "if": { "compare_string": [ "monster", { "global_val": "tmp" } ] },
        "then": {
          "run_eocs": {
            "id": "anthropomorph_actor_use_check_monster",
            "condition": { "or": [
              { "npc_has_species": "CUBI" },
              { "npc_has_flag": "DOGFOOD" },
              { "npc_has_flag": "ANTHRO_FELINE" },
              { "npc_has_flag": "ANTHRO_URSINE" },
              { "npc_has_flag": "ANTHRO_CATTLE" },
              { "npc_has_flag": "ANTHRO_RABBIT" },
              { "npc_has_species": "BIRD" }
            ] },
            "effect": [
              {
                "run_eoc_selector": [
                  "select_npc_anthro_succubi_morehuman",
                  "select_npc_anthro_succubi_lesshuman",
                  
                  "select_npc_anthro_incubi_morehuman",
                  "select_npc_anthro_incubi_lesshuman",
                  
                  "select_npc_anthro_canine_morehuman_male",
                  "select_npc_anthro_canine_half_male",
