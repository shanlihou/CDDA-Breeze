                  "非人生物(女)",
                  
                  "取消"
                ],
                "hide_failing": true,
                "allow_cancel": true,
                "title": "喜欢什么外观？"
              },
              {
                "if": { "not": { "compare_string": [ "", { "global_val": "anthro_npc" } ] } },
                "then": [
                  { "npc_cast_spell": { "id": "spell_anthropomorph_1", "hit_self": true } },
                  {
                    "u_spawn_npc": { "global_val": "anthro_npc" },
                    "target_var": { "context_val": "pnt" },
                    "real_count": 1,
                    "min_radius": 0,
                    "max_radius": 0
                  }
                ]
              }
            ],
            "false_effect": { "message": "不能把这种生物变成人类。", "type": "info" }
          },
          "beta_loc": { "context_val": "pnt" }
        }
      },
      {
        "if": { "compare_string": [ "", { "global_val": "anthro_npc" } ] },
        "then": { "message": "Never mind." },
        "else": "npc_die"
      }
    ],
    "false_effect": {
      "if": { "not": { "u_has_item": "syringe" } },
      "then": { "message": "<npc_name>必须使用针筒。" }
    }
