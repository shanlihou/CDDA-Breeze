[
  {
    "type": "effect_on_condition",
    "id": "EOC_SETUP_WIFE_U_CONSTATNTS",
    "eoc_type": "EVENT",
    "required_event": "game_start",
    "effect": [
      { "math": [ "WIFE_U_CORRUPT_TURNS", "=", "100" ] },
      { "math": [ "WIFE_U_MUTATE_CHANCE", "=", "20" ] }
    ]
  },
  
  {
    "type": "monster_attack",
    "attack_type": "melee",
    "id": "START_WIFE_U",
    "condition": {
      "and": [
        { "or": [
          { "not": { "math": [ "HENTAI_EXTEND_CUBI_WIFE_ONLY_HUMAN" ] } },
          "npc_is_character"
        ] },
        { "or": [
          { "not": { "u_has_effect": "pet" } },
          { "math": [ "HENTAI_EXTEND_PET_CUBI_WIFE_ENEMY" ] },
          { "and": [
            { "u_has_effect": "cubi_allow_seduce_player" },
            "npc_is_avatar"
          ] }
        ] },
        { "not": { "u_has_effect": "wife_u_cooldown" } },
        { "not": { "u_has_effect": "wife_u_dominating" } },
        { "or": [
          { "npc_has_flag": "GRAB" },
          { "npc_has_effect": "sleep" },
          { "npc_has_any_effect": [ "crushed", "downed", "in_pit", "tied", "webbed" ] },
          { "npc_has_move_mode": "prone" }
        ] }
      ]
    },
    "cooldown": 0
  },
