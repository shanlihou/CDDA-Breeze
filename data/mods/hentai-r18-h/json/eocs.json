[
  {
    "type": "effect_on_condition",
    "id": "eoc_check_u_query_tile_target",
    "//": [
      "u_query_tileで選択した地点に何がいるか確認",
      "開発版ではかなり単純にできるので不要かも",
      "万が一選択した地点の対象とAlphaの名前が一致すると機能しない"
    ],
    "//pnt": "選択した地点",
    "//retv": "結果を返す変数名, 結果はu, npc, monster, null",
    "condition": { "expects_vars": [ "pnt", "retv" ] },
    "effect": [
      { "u_location_variable": { "context_val": "u_pos" } },
      {
        "if": { "compare_string": [ { "context_val": "u_pos" }, { "context_val": "pnt" } ] },
        "then": {
          "set_string_var": "u",
          "target_var":  { "var_val": "retv" }
        },
        "else": {
          "run_eocs": {
            "id": "yiff_actor_use_check_select_something",
            "effect": [
              {
                "set_string_var": "<npc_name>",
                "target_var": { "context_val": "npc_name" },
                "parse_tags": true
              },
              {
                "set_string_var": "<u_name>",
                "target_var": { "context_val": "u_name" },
                "parse_tags": true
              },
              {
                "if": { "compare_string": [ { "context_val": "u_name" }, { "context_val": "npc_name" } ] },
                "then": {
                  "set_string_var": "null",
                  "target_var":  { "var_val": "retv" }
                },
                "else": {
                  "if": "npc_is_npc",
                  "then": {
                    "set_string_var": "npc",
                    "target_var":  { "var_val": "retv" }
                  },
                  "else": {
                    "set_string_var": "monster",
                    "target_var":  { "var_val": "retv" }
                  }
                }
              } 
            ]
          },
          "beta_loc": { "context_val": "pnt" }
        }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "gain_corrupt",
    "//": "オリジナルではintensityは全てrand(1, 20)",
    "condition": {
      "and": [
        { "expects_vars": [ "duration" ] },
        { "math": [ "rand(19) + 1", ">", "u_val('intelligence')" ] }
      ]
    },
    "effect": { "u_add_effect": "corrupt", "duration": { "context_val": "duration" } },
    "false_effect": {
      "if": "u_is_avatar",
      "then": { "message": "但是你抵抗住了欲望。" },
      "else": {
        "if": "player_see_u",
        "then": { "message": "但是<u_name>抵抗住了欲望。" }
      }
    }
  },
  {
    "type": "effect_on_condition",
    "id": "eoc_gain_lust_alpha",
    "condition": { "expects_vars": [ "rslt", "val" ] },
    "//rslt": "絶頂したかどうか",
    "//val": "基本のlust時間、SEXUAL_SENSITIVEフラグで2倍",
    "effect": [
      { "math": [ "v_rslt", "=", "0" ] },
      {
        "if": { "u_has_flag": "SEXUAL_SENSITIVE" },
        "then": { "math": [ "_val", "*=", "2" ] }
      },
      { "u_add_effect": "lust", "duration": { "context_val": "val" } },
      {
        "if": { "u_has_effect": "lust", "intensity": 100 },
        "then":  [
          { "u_lose_effect": "lust" },
          { "math": [ "v_rslt", "=", "1" ] },
          {
            "if": {
              "and": [
                { "math": [ "HENTAI_EXTEND_AFTER_ORGASM" ] },
                "u_is_character"
              ]
            },
            "then": { "u_add_effect": "after_orgasm", "duration": "5 s" }
          },
          {
            "if": { "u_has_species": "CUBI" },
            "then": { "set_string_var": "d_body_fluids", "target_var": { "context_val": "fluid" } },
            "else": { "set_string_var": "h_body_fluids", "target_var": { "context_val": "fluid" } }
          },
          {
            "if": "u_is_avatar",
            "then": [
              { "message": "你到极限了！", "type": "info" },
              {
                "//": [
                  "u_var_changedイベントに依存しているのでmathは使えない",
                  "開発版ではtrigger_eventを使う"
                ],
                "math": [ "reached_orgasm", "+=", "1" ]
              }
            ],
            "else": {
              "if": "player_see_u",
              "then": { "message": "<u_name>到极限了！", "type": "info" }
            }
          },
          { "u_location_variable": { "context_val": "pnt" } },
          { "map_spawn_item": { "context_val": "fluid" }, "loc": { "context_val": "pnt" } },
          { "u_cast_spell": { "id": "STOP_50_MOVES", "hit_self": true } }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "eoc_gain_lust_beta",
    "condition": { "expects_vars": [ "rslt", "val" ] },
    "//rslt": "絶頂したかどうか",
    "//val": "lust時間",
    "effect": [
      { "math": [ "v_rslt", "=", "0" ] },
      {
        "if": { "u_has_flag": "SEXUAL_SENSITIVE" },
        "then": { "math": [ "_val", "*=", "2" ] }
      },
      { "npc_add_effect": "lust", "duration": { "context_val": "val" } },
      {
        "if": { "npc_has_effect": "lust", "intensity": 100 },
        "then":  [
          { "npc_lose_effect": "lust" },
          { "math": [ "v_rslt", "=", "1" ] },
          {
            "if": {
              "and": [
                { "math": [ "HENTAI_EXTEND_AFTER_ORGASM" ] },
                "npc_is_character"
              ]
            },
            "then": { "npc_add_effect": "after_orgasm", "duration": "5 s" }
          },
          {
            "if": { "npc_has_species": "CUBI" },
            "then": { "set_string_var": "d_body_fluids", "target_var": { "context_val": "fluid" } },
            "else": { "set_string_var": "h_body_fluids", "target_var": { "context_val": "fluid" } }
          },
          {
            "if": "npc_is_avatar",
            "then": [
              { "message": "你到极限了！", "type": "info" },
              { "math": [ "reached_orgasm", "+=", "1" ] }
            ],
            "else": {
              "if": "player_see_npc",
              "then": { "message": "<u_name>到极限了！", "type": "info" }
            }
          },
          { "npc_location_variable": { "context_val": "pnt" } },
          { "map_spawn_item": { "context_val": "fluid" }, "loc": { "context_val": "pnt" } },
          { "npc_cast_spell": { "id": "STOP_50_MOVES", "hit_self": true } }
        ]
      }
    ]
  },
  {
    "//": "マッサージ器使用後を統計",
    "type": "effect_on_condition",
    "id": "EOC_ACT_VIBE_STATISTIC",
    "eoc_type": "EVENT",
    "required_event": "character_finished_activity",
    "condition": {
      "and": [
        "u_is_avatar",
        { "compare_string": [ "ACT_VIBE", { "context_val": "activity" } ] },
        { "not": { "math": [ "_canceled" ] } }
      ]
    },
    "effect": [
      { "u_add_effect": "finished_onani", "duration": "1 s" },
      {
        "//": [
          "u_var_changedイベントに依存しているのでmathは使えない",
          "開発版ではtrigger_eventを使う"
        ],
        "math": [ "reached_orgasm", "+=", "1" ]
      }
    ]
  },
