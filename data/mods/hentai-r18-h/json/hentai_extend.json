  {
    "type": "effect_on_condition",
    "id": "EOC_SWITCH_SEDUCE_AVATAR_EFFECT",
    "condition": { "u_has_effect": "pet" },
    "effect": [
      {
        "if": { "u_has_effect": "cubi_allow_seduce_player" },
        "then": [
          {
            "set_string_var": "<u_name>的诱惑结束了吗？",
            "target_var": { "context_val": "msg" },
            "parse_tags": true
          },
          {
            "if": { "npc_query": { "context_val": "msg" }, "default": false },
            "then": [
              { "u_lose_effect": "cubi_allow_seduce_player" },
              { "u_lose_effect": "docile" },
              { "u_lose_effect": "worked_on" },
              { "message": "<u_name>停止了诱惑。", "type": "info" }
            ]
          }
        ],
        "else": [
          {
            "set_string_var": "宠物<u_name>允许对玩家使用诱惑吗？\n(开发中。如果不起作用，请移动或重复启用禁用几次。有时会真的攻击，请注意！)",
            "target_var": { "context_val": "msg" },
            "parse_tags": true
          },
          {
            "if": { "npc_query": { "context_val": "msg" }, "default": false },
            "then": [
              { "u_add_effect": "cubi_allow_seduce_player", "duration": "PERMANENT" },
              { "u_add_effect": "docile", "duration": "PERMANENT" },
              { "u_add_effect": "worked_on", "duration": "PERMANENT" },
              { "message": "<u_name>开始就当场诱惑你...", "type": "info" }
            ]
          }
        ]
      }
    ],
    "false_effect": { "message": "<u_name>不属于友好生物！" }
  },
