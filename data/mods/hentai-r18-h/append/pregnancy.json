  {
    "type": "effect_on_condition",
    "id": "EOC_SET_PREGNANCY_CONSTANTS",
    "eoc_type": "EVENT",
    "required_event": "game_begin",
    "effect": [
      {
        "if": { "math": [ "HENTAI_EXTEND_PREGNANCY_DAY == 0" ] },
        "then": { "math": [ "HENTAI_EXTEND_PREGNANCY_DAY", "=", "280" ] }
      },
      {
        "//": "タイミングがあっていると25%、月経周期や精子の生存日数を考えるとそれの1/5...でもちょっと高めで15%にしておこう",
        "math": [ "PREGNANCY_CHANCE", "=", "15" ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_MOVE_NEXT_PREGNANT_STAGE",
    "//": [
      "妊娠の*一月*の長さをオプションから設定...したかった",
      "整数のオプションが取得できるようになるのは0.Hの少し後(#71074)",
      "デフォの280日なら4週"
    ],
    "condition": { "expects_vars": [ "effect" ] },
    "effect": [
      { "math": [ "_pregnancy_random", "=", "_pregnancy_random ? _pregnancy_random : 1" ] },
      { "math": [ "_month", "=", "floor(HENTAI_EXTEND_PREGNANCY_DAY * 24 * 60 * 60 * _pregnancy_random / 10)" ] },
      { "u_add_effect": { "context_val": "effect" } , "duration": { "context_val": "month" } }
    ]
  },
