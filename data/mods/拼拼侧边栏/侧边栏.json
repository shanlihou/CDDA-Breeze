  {
    "id": "饿度",
    "type": "widget",
    "label": "",
    "style": "text",
    "clauses": [
      { "id": "engorged", "text": "吃撑", "color": "red", "condition": { "u_has_effect": "hunger_engorged" } },
      { "id": "full", "text": "饱饱", "color": "yellow", "condition": { "u_has_effect": "hunger_full" } },
      {
        "id": "satisfied",
        "text": "吃饱",
        "color": "green",
        "condition": { "u_has_effect": "hunger_satisfied" }
      },
      { "id": "blank", "text": "不饿", "color": "light_gray", "condition": { "u_has_effect": "hunger_blank" } },
      { "id": "hungry", "text": "空腹", "color": "c_light_gray", "condition": { "u_has_effect": "hunger_hungry" } },
      {
        "id": "very_hungry",
        "text": "饿了",
        "color": "yellow",
        "condition": { "u_has_effect": "hunger_very_hungry" }
      },
      {
        "id": "near_starving",
        "text": "很饿",
        "color": "red",
        "condition": { "u_has_effect": "hunger_near_starving" }
      },
      { "id": "starving", "text": "饿！!", "color": "red", "condition": { "u_has_effect": "hunger_starving" } },
      {
        "id": "famished",
        "text": "饿嗝‌",
        "color": "light_red",
        "condition": { "u_has_effect": "hunger_famished" }
      }
    ]
  },
  {
    "id": "渴度",
    "type": "widget",
    "label": "",
    "style": "text",
    "clauses": [
      {
        "id": "parched",
        "text": "无水",
        "color": "light_red",
        "condition": { "compare_int": [ { "u_val": "instant_thirst" }, ">", { "const": 520 } ] }
      },
      {
        "id": "dehydrated",
        "text": "脱水",
        "color": "light_red",
        "condition": {
          "and": [
            { "compare_int": [ { "u_val": "instant_thirst" }, ">", { "const": 240 } ] },
            { "compare_int": [ { "u_val": "instant_thirst" }, "<=", { "const": 520 } ] }
          ]
        }
      },
      {
        "id": "very_thirsty",
        "text": "很渴",
        "color": "yellow",
        "condition": {
          "and": [
            { "compare_int": [ { "u_val": "instant_thirst" }, ">", { "const": 80 } ] },
            { "compare_int": [ { "u_val": "instant_thirst" }, "<=", { "const": 240 } ] }
          ]
        }
      },
      {
        "id": "thirsty",
        "text": "口渴",
        "color": "yellow",
        "condition": {
          "and": [
            { "compare_int": [ { "u_val": "instant_thirst" }, ">", { "const": 40 } ] },
            { "compare_int": [ { "u_val": "instant_thirst" }, "<=", { "const": 80 } ] }
          ]
        }
      },
      {
        "id": "neutral",
        "text": "不渴",
        "color": "light_gray",
        "condition": {
          "and": [
            { "compare_int": [ { "u_val": "instant_thirst" }, ">=", { "const": 0 } ] },
            { "compare_int": [ { "u_val": "instant_thirst" }, "<=", { "const": 40 } ] }
          ]
        }
      },
      {
        "id": "slaked",
        "text": "喝足",
        "color": "green",
        "condition": {
          "and": [
            { "compare_int": [ { "u_val": "instant_thirst" }, ">=", { "const": -20 } ] },
            { "compare_int": [ { "u_val": "instant_thirst" }, "<", { "const": 0 } ] }
          ]
        }
      },
      {
        "id": "hydrated",
        "text": "喝多",
        "color": "green",
        "condition": {
          "and": [
            { "compare_int": [ { "u_val": "instant_thirst" }, ">=", { "const": -60 } ] },
            { "compare_int": [ { "u_val": "instant_thirst" }, "<", { "const": -20 } ] }
          ]
        }
      },
      {
        "id": "turgid",
        "text": "喝撑",
        "color": "green",
        "condition": { "compare_int": [ { "u_val": "instant_thirst" }, "<", { "const": -60 } ] }
      }
    ]
  },
