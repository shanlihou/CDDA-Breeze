[
    {
    
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"来，开始永久的日后谈吧\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"欢迎来到箱庭的故事\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"让我们一起来欣赏扭曲之舞吧\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"你听过那最边缘的戏剧吗?\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"让我们再举办一次茶会吧\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"他的铃声再也不会响起・・・不，算了吧\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"做一个你的玩偶好了\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"不要在意失败。毕竟是死人啊\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"人偶是很可爱的东西呢\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"让帷幕升起，让死者起舞\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"・・・窃窃私语・・・\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"这个世界是一场美丽的噩梦\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"请尽情地伤害彼此、侮辱彼此吧\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_sama",
        "sound" : "\"请准备一个10面体的骰子\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"到了展示我实力的时候了呢\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"我是完美而美丽的存在!\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"女孩子之间讨厌这种事的人也有吗，嗯，哦!\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"怎么可能比得过完美又优雅的我呢\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"吾乃至高无上的孤高死灵法师!\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"我可不是什么破骨头\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"我是一名死灵法师，我会做到的!\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"呜呜呜(抽泣)・・・\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"不要在叫我的名字加小字！\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"呀啊啊啊啊啊\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"噜噜噜♪\"",
        "volume" : 30
    },
    {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"呀、一百面骰子。。。\"",
        "volume" : 30
    },
        {
        "type" : "speech",
        "speaker" : "mon_nec_ZQ_chang",
        "sound" : "\"你觉得自己运气很好吗?\"",
        "volume" : 30
    }

]