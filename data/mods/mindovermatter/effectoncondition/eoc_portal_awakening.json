  {
    "type": "effect_on_condition",
    "id": "EOC_PORTAL_BIOKIN_AWAKENING",
    "condition": { "not": { "u_has_trait": "BIOKINETIC" } }, 
    "effect": [
      { "u_message": "一声咆哮充斥你的脑海，甚至比传送门风暴的尖啸狂乱更为响亮。新的力量与活力骤然充盈全身。你挺直腰杆，无视狂风和万花筒般的天空，紧握双拳。你感觉自己能对抗整个世界，能不停歇地冲刺一小时，能将那些巨型昆虫摁倒在地并压住，能闪避子弹。你松开拳头摇了摇头，但那股力量感依旧留存。", "popup": true },
      { "u_add_trait": "BIOKINETIC" }, 
      { "u_add_trait": "BIOKIN_NEEDS" }
     ], 
    "false_effect": [
      { "u_message": "一声咆哮充斥你的脑海，甚至比传送门风暴的尖啸狂乱更为响亮。你的脑袋随着万花筒般的天空一起胀痛，肌肉开始不受控制地痉挛。它们突然僵住，你瘫倒在地，仰望着天空，动弹不得。" },
      { "u_add_effect": "psionic_overload", "duration": { "arithmetic": [ { "global_val": "var", "var_name": "ps_str" }, "*", { "time": "1 hours" } ] } },
      { "u_add_effect": "effect_biokin_overload", "duration": { "arithmetic": [ { "global_val": "var", "var_name": "ps_str" }, "*", { "time": "2 hours" } ] } },
      { "u_add_effect": "downed", "duration": { "arithmetic": [ { "global_val": "var", "var_name": "ps_str" }, "*", { "time": "5 seconds" } ] } },
      { "u_add_effect": "motor_seizure", "duration": { "arithmetic": [ { "global_val": "var", "var_name": "ps_str" }, "*", { "time": "5 seconds" } ] } },
      { "arithmetic": [ { "u_val": "stamina" }, "-=", { "const": 4000 } ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PORTAL_CLAIR_AWAKENING",
    "condition": { "not": { "u_has_trait": "CLAIRSENTIENT" } }, 
    "effect": [
      { "u_message": "一声咆哮充斥你的脑海，甚至比传送门风暴的尖啸狂乱更为响亮。你闭上眼睛，但依然能看见——起初只是眼皮后的微光，然后像列车驶出隧道般，光芒扩散开来，照亮了你的周围。你能看到所有方向，你能看到你周围每一片草叶的背后和下方，在风暴的巫光中闪耀，直到你的意识猛地回到身体，你被这冲击震得后退。当你再次睁眼时，周围的色彩更加明亮，声音也比以前更加清晰。", "popup": true },
      { "u_add_trait": "CLAIRSENTIENT" }, 
      { "u_add_trait": "CLAIR_SENSES" } 
    ],
    "false_effect": [
      { "u_message": "一声咆哮充斥你的脑海，甚至比传送门风暴的尖啸狂乱更为响亮。你的脑袋随着万花筒般的天空一起胀痛，视野也开始摇晃。天空变得明亮，然后暗沉。声音渐渐消失，随即又在耳边轰鸣，然后整个世界突然消失，留下你身处寂静的黑暗中。" },
      { "u_add_effect": "psionic_overload", "duration": { "arithmetic": [ { "global_val": "var", "var_name": "ps_str" }, "*", { "time": "1 hours" } ] } },
