      "CITY_START",
      "LONE_START"
    ],
    "points": 2,
    "start_name": "Shady Basement",
    "allowed_locs": [
      "sloc_basement_bionic"
    ],
    "professions": [
      "cyberjunkie",
      "faulty_bionic",
      "cykotic",
      "razorgirl",
      "bionic_installer"
    ]
