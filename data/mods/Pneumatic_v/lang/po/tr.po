#. ~ Description of magazine "20-round bolt magazine"
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\pneumatic_ammo.json
msgid "Stores 20 rounds of bolt."
msgstr "储存20发弩矢。"

#. ~ Magazine name
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\pneumatic_ammo.json
msgid "40-round bolt magazine"
msgid_plural "40-round bolt magazines"
msgstr[0] "40发弩矢弹匣"

#. ~ Description of magazine " 40-round bolt magazine"
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\pneumatic_ammo.json
