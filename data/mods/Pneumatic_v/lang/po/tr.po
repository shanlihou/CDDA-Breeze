#. ~ Name of an ammunition type
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\ammo_types.json
msgid "Shotcanister"
msgstr "霰弹筒"

#. ~ MOD name
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\modinfo.json
msgid "Pneumatic Guns And More - Maintained By A.Vermillion"
msgstr "气动及自制武器 - A.Vermillion作"

#. ~ Description of MOD "Pneumatic Guns And More - Maintained By A.Vermillion"
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\modinfo.json
msgid ""
"Re-introduces removed pneumatic weapons into CDDA and more. Mininuke "
"launcher is still removed and rail rifle is worse than its Aftershock "
"counterpart, sorry about that."
msgstr ""
"重新加入了旧版的自制武器，以及增加了新的。没有加入微型核弹发射器，轨道步枪相"
"对于Aftershock的版本也更差。还在平衡中。"

#. ~ Item name
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\pneumatic_ammo.json
msgid "scrap shotcanister"
msgid_plural "scrap shotcanisters"
msgstr[0] "废料霰弹筒"

#. ~ Description of "scrap shotcanister"
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\pneumatic_ammo.json
msgid ""
"This small paper canister resembling a crude shotshell is filled to the brim "
"with assorted pieces of scrap metal."
msgstr "塞满废金属的霰弹状纸筒。"

#. ~ Item name
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\pneumatic_ammo.json
msgid "pebble shotcanister"
msgid_plural "pebble shotcanisters"
msgstr[0] "石子霰弹筒"

#. ~ Description of "pebble shotcanister"
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\pneumatic_ammo.json
msgid ""
"This small paper canister resembling a crude shotshell is filled to the brim "
"with tiny pebbles.  Damage is pathetic but flight is much more stable than "
"scrap."
msgstr "塞满石子的霰弹状纸筒。伤害很差，但飞行比废料更加稳定。"

#. ~ Item name
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\pneumatic_ammo.json
msgid "flechette shotcanister"
msgid_plural "flechette shotcanisters"
msgstr[0] "钢镖霰弹筒"

#. ~ Description of "flechette shotcanister"
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\pneumatic_ammo.json
msgid ""
"This small paper canister resembling a crude shotshell is filled to the brim "
"with handmade flechettes, giving it some armor piercing capabilities."
msgstr "塞满钢镖的霰弹状纸筒，有一定穿甲能力。"

#. ~ Item name
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\pneumatic_ammo.json
msgid "bearing shotcanister"
msgid_plural "bearing shotcanisters"
msgstr[0] "滚珠霰弹筒"

#. ~ Description of "bearing shotcanister"
#: C:\Users\admin\Desktop\games\cdda experimental\dda\userdata\mods\Pneumatic
#: Weapons AV\pneumatic_ammo.json
msgid ""
"This small paper canister resembling a crude shotshell is filled to the brim "
"with handmade bearings, stabilizing its flight pattern a tiny bit."
msgstr "塞满滚珠的霰弹状纸筒，飞行相对稳定。"

